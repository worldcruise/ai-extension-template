{
   "action": {
      "default_icon": {
         "128": "icon128.png",
         "16": "icon16.png",
         "48": "icon48.png"
      },
      "default_title": "Open ChatGPT Automation Panel"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "content_scripts": [ {
      "js": [ "content.js" ],
      "matches": [ "*://chatgpt.com/*", "*://*.chatgpt.com/*" ],
      "run_at": "document_end"
   } ],
   "description": "Unlimited batch automation for ChatGPT. Auto-submit prompts, auto-download images and text directly in your sidebar.",
   "host_permissions": [ "*://chatgpt.com/*", "*://*.chatgpt.com/*", "*://*.oaiusercontent.com/*" ],
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "48": "icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "ChatGPT Automation - Auto Batch",
   "permissions": [ "sidePanel", "downloads", "contentSettings", "storage", "unlimitedStorage", "tabs", "scripting", "activeTab", "alarms" ],
   "side_panel": {
      "default_path": "sidepanel.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.1.0"
}
